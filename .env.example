# Firebase Admin SDK. Either use Application Default Credentials or set this file path.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
RECOVERAI_PUBLIC_WEBHOOK_ONLY=false

# Razorpay TEST MODE credentials only. Leave blank to use safe demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local LLM reasoning. No cloud API key is required for Ollama.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

FRONTEND_URL=http://localhost:5173
