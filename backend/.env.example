# Copy this file to .env and fill in only local Test Mode values.
RECOVERAI_STORAGE_MODE=firestore
RECOVERAI_PUBLIC_WEBHOOK_ONLY=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
RECOVERAI_MIN_SUCCESSFUL_PAYMENTS=1
RECOVERAI_MIN_PAYMENT_FAILURE_SCORE=0.70
RECOVERAI_MIN_ABANDONMENT_SCORE=0.60
RECOVERAI_MIN_OVERDUE_SCORE=0.60
RECOVERAI_MAX_RECOVERY_AMOUNT_PAISE=5000000
