# Copy this file to .env and fill in only local Test Mode values.
RECOVERAI_STORAGE_MODE=firestore
RECOVERAI_PUBLIC_WEBHOOK_ONLY=false
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional local LLM reasoning. No cloud API key is required for Ollama.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=30

# Enable only after Firebase Authentication is configured for the merchant frontend.
RECOVERAI_AUTH_ENABLED=false

# Creates a human-review recovery case from a signed external payment.failed event.
RECOVERAI_RAZORPAY_FAILURE_DETECTION_ENABLED=false
FRONTEND_URL=http://localhost:5173
RECOVERAI_MIN_SUCCESSFUL_PAYMENTS=1
RECOVERAI_MIN_PAYMENT_FAILURE_SCORE=0.70
RECOVERAI_MIN_ABANDONMENT_SCORE=0.60
RECOVERAI_MIN_OVERDUE_SCORE=0.60
RECOVERAI_MAX_RECOVERY_AMOUNT_PAISE=5000000
